# HTTP server
PORT=3000
CORS_ORIGINS=http://localhost:3001

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
STAFF_REGISTRATION_SECRET=replace-with-a-random-staff-registration-secret

# Redis: use REDIS_URL, or configure host/port and optional credentials below.
# Upstash users should use a rediss:// URL or an *.upstash.io hostname.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Optional AI provider configuration; set both values to enable AI routes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional integration test configuration. The script writes synthetic users
# and clinical test data only when E2E_ALLOW_DATABASE_WRITES=true.
API_BASE_URL=http://localhost:3000
E2E_ALLOW_DATABASE_WRITES=false
E2E_TEST_PASSWORD=
RUN_GEMINI_E2E=false

# Local/demo database seeding (never use the shared demo password in production)
FRONTEND_BASE_URL=http://localhost:3001
